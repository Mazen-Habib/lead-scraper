{
  "name": "lead-scraper",
  "version": "1.0.0",
  "description": "Free lead scraper - Google Maps + website email extraction, outputs scoring-ready CSV",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "scrape": "node src/index.js",
    "test": "node --test test/*.test.js",
    "sync-shared-data": "node scripts/sync-shared-data.js",
    "sync-shared-data:check": "node scripts/sync-shared-data.js --check",
    "export-all": "node scripts/export-all-leads.js",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.6",
    "cheerio": "^1.0.0",
    "cloakbrowser": "^0.4.10",
    "crawlee": "^3.18.1",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.4.2",
    "patchright": "^1.61.1",
    "playwright": "^1.45.0",
    "playwright-core": "^1.61.1"
  },
  "devDependencies": {
    "pg": "^8.22.0"
  }
}
