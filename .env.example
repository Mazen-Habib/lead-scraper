# Supabase — used by src/index.js to sync the deduped master lead list
# after every scrape (local run or nightly GitHub Action).
SUPABASE_URL=https://jvtxbkfpvqyjunwbtzza.supabase.co
# service_role key — server-side only, bypasses RLS. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — only needed for one-off migrations via
# scripts/apply-migration.js, not required for normal scrape runs.
SUPABASE_DB_URL=
