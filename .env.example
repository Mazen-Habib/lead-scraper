# Supabase — used by src/index.js to sync the deduped master lead list
# after every scrape (local run or weekly GitHub Action).
SUPABASE_URL=https://jvtxbkfpvqyjunwbtzza.supabase.co
# service_role key — server-side only, bypasses RLS. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — only needed for one-off migrations via
# scripts/apply-migration.js, not required for normal scrape runs.
SUPABASE_DB_URL=

# ScrapegraphAI LLM enrichment (src/scrapers/scrapegraph_enricher.py) — fills
# in email/phone/socials for leads whose website crawl didn't find one.
# Rotates through whichever of these are set; leave blank to skip this step.
GROQ_KEY_1=
GROQ_KEY_2=
GROQ_KEY_3=
MISTRAL_KEY_1=
MISTRAL_KEY_2=
MISTRAL_KEY_3=

# Firecrawl enrichment (src/lib/firecrawlEnricher.js) — third-rung email/contact
# fallback, after emailFinder.js and ScrapegraphAI. Optional: leave blank to
# skip this rung entirely (the run behaves exactly as if this file didn't exist).
# Free tier: https://firecrawl.dev (500 credits/month).
FIRECRAWL_API_KEY=

# curl-impersonate binary name (src/lib/curlImpersonate.js) — TLS-fingerprint
# fallback for emailFinder.js's website crawl. Optional: only needed if you've
# installed curl-impersonate locally; otherwise this fallback self-disables.
# CURL_IMPERSONATE_BIN=curl_chrome116
