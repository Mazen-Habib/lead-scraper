# Supabase — used by src/index.js to sync the deduped master lead list
# after every scrape (local run or weekly GitHub Action).
SUPABASE_URL=https://jvtxbkfpvqyjunwbtzza.supabase.co
# service_role key — server-side only, bypasses RLS. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — only needed for one-off migrations via
# scripts/apply-migration.js, not required for normal scrape runs.
SUPABASE_DB_URL=

# ScrapegraphAI LLM enrichment (src/scrapers/scrapegraph_enricher.py) — fills
# in email/phone/socials for leads whose website crawl didn't find one.
# Rotates through whichever of these are set; leave blank to skip this step.
GROQ_KEY_1=
GROQ_KEY_2=
GROQ_KEY_3=
MISTRAL_KEY_1=
MISTRAL_KEY_2=
MISTRAL_KEY_3=
