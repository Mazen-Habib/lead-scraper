# Separate third-party project living in this folder — not part of the scraper
CLoak Browser/

# Vendored reference copy of the scrapling PyPI package (analyzed for its
# StealthyFetcher API, not shipped — the actual runtime dependency is
# `pip install "scrapling[fetchers]"`, same as scrapegraphai).
Scrapling-main/

# Vendored reference copies of open-source scraping tools (crawlee, firecrawl,
# curl-impersonate, markitdown, autoscraper, scrapy, scrcpy) — explored to decide
# what to integrate (see knowledge.md), not shipped as part of the repo. The
# actual runtime dependency is `crawlee` in package.json; the rest are either
# opt-in subprocess/binary tools or, for scrapy/scrcpy, not integrated at all.
Scrapper_directories/

# Vendored upstream repos, kept on disk as local reference but not shipped —
# same reasoning as Scrapper_directories/ above, applied consistently.
#   Scrapegraph-ai-main/  is the upstream of the `scrapegraphai` PyPI package.
#     src/scrapers/scrapegraph_enricher.py imports it from pip
#     (`from scrapegraphai.graphs import ...`), never from this folder, so the
#     385 tracked files were pure weight — nothing in this repo referenced them.
#   Agent-Reach-main/     is reference material for the outreach work described
#     in agent-reach-txt.txt. No code imports it either.
# Both remain in git history if you need them back:
#   git checkout <commit-before-this> -- Agent-Reach-main
Scrapegraph-ai-main/
Agent-Reach-main/

# Crawlee's local runtime cache (request queue / key-value store state from
# src/engines/crawleeEngine.js runs) — regenerated automatically, never meant
# to be committed, same category as .cache/ above.
storage/

# Dependencies
node_modules/

# Scraped output — CSVs committed and tracked for growth; master.json is internal state
output/master.json
*.log

# Overture Maps bbox downloads (output/cache/overture_<country>.parquet) —
# regenerated automatically per config.overture.cacheMaxAgeDays, ~250MB per
# country, never meant to be committed.
output/cache/

# Playwright browser cache
.cache/

# Python bytecode cache
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets — never commit
.env
.env.local
credentials.txt
supabase_credentials.txt
*credentials*.txt
creds*.txt
*creds*.txt
*.key
# Preview artifact from scripts/reclassify-supabase.js, regenerated by each
# dry run — a snapshot of a proposed change, not a source of truth.
output/reclassify-preview.json
