# ── GitHub source for lead CSV data ──────────────────────────────────────────
# The nightly scraper commits output/leads-master.csv to this repo.
# The portal fetches that file to power the dashboard.

GITHUB_OWNER=Mazen-Habib
GITHUB_REPO=lead-scraper

# Personal access token — only required for PRIVATE repos.
# Needs: read:contents scope only.
# Leave blank if the repo is public.
GITHUB_TOKEN=
