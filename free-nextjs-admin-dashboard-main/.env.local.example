# ── Supabase (primary lead source) ───────────────────────────────────────────
# The weekly scraper upserts every run's deduped leads into the `leads`
# table. The portal reads it directly with the publishable/anon key (RLS
# grants read-only access — see supabase/migrations/0001_create_leads.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Legacy GitHub CSV fallback (only used if Supabase env vars above are unset) ──
GITHUB_OWNER=Mazen-Habib
GITHUB_REPO=lead-scraper

# Personal access token — only required for PRIVATE repos.
# Needs: read:contents scope only.
# Leave blank if the repo is public.
GITHUB_TOKEN=
